# Paste the complete Ethereum mainnet endpoint copied from Google Blockchain RPC.
GOOGLE_BLOCKCHAIN_RPC_URL=

USDC_ADDRESS=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
USDT_ADDRESS=0xdac17f958d2ee523a2206206994597c13d831ec7
TRANSFER_TOPIC=0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef
USDC_DECIMALS=6
USDT_DECIMALS=6

CHAIN_ID=1
START_BLOCK=25638000
CONFIRMATION_BUFFER=6
BLOCK_BATCH_SIZE=5
RPC_LOG_CHUNK_SIZE=5
POLL_INTERVAL_MS=30000
MIN_AMOUNT=100000
RPC_TIMEOUT_MS=20000
RPC_MAX_RETRIES=2
RPC_RETRY_BASE_MS=5000
MAX_RPC_RESPONSE_BYTES=10485760

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=data/local-storage
GCS_EVENTS_BUCKET=
GCS_STATE_BUCKET=
INDEXER_LOCK_FILE=data/indexer.lock

API_PORT=3001
API_HOST=127.0.0.1
# Maximum age of the in-memory event index before a request awaits a storage refresh.
API_REFRESH_MS=30000
# How long a request waits for storage refresh before falling back to stale-data rules.
API_REFRESH_DEADLINE_MS=5000
# Cached data may be served after a failed or timed-out refresh until this age.
# Must be greater than or equal to API_REFRESH_MS.
API_MAX_STALE_MS=600000
API_MAX_PAGE_SIZE=50
API_ALLOWED_ORIGIN=http://localhost:3000
RETENTION_DAYS=7

PROJECT_ID="swm-v1"
